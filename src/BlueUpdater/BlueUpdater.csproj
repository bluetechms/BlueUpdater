<Project Sdk="Microsoft.NET.Sdk.Worker">

  <PropertyGroup>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>BlueUpdater</RootNamespace>
    <AssemblyName>BlueUpdater</AssemblyName>
    <Version>1.0.0.0</Version>
    <FileVersion>1.0.0.0</FileVersion>
    <AssemblyVersion>1.0.0.0</AssemblyVersion>
    <InvariantGlobalization>true</InvariantGlobalization>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <!-- Public keys the manifest signature is checked against, compiled in. Override per build with
         -p:PubKeysFile=path (tests use their own throwaway key; releases use pubkeys.txt). -->
    <PubKeysFile Condition="'$(PubKeysFile)' == ''">pubkeys.txt</PubKeysFile>
  </PropertyGroup>

  <ItemGroup>
    <EmbeddedResource Include="$(PubKeysFile)" LogicalName="pubkeys.txt" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting.WindowsServices" Version="8.0.1" />
    <PackageReference Include="System.ServiceProcess.ServiceController" Version="8.0.1" />
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="8.0.0" />
  </ItemGroup>

</Project>
